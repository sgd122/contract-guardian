# ============================================
# 환경 변수
# NEXT_PUBLIC_ 접두사: 클라이언트(브라우저)에서 접근 가능
# 접두사 없음: 서버 전용 (API 키 등 민감 정보)
# ============================================

# Supabase (클라이언트 + 서버)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase (서버 전용)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Claude API (서버 전용)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API (서버 전용, optional)
GOOGLE_GEMINI_API_KEY=

# Toss Payments
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# Google OAuth (Supabase Auth Provider)
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxx

# GitHub OAuth (Supabase Auth Provider)
GITHUB_OAUTH_CLIENT_ID=Ov23liXXX
GITHUB_OAUTH_CLIENT_SECRET=xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=계약서 지킴이

# Resend (email notifications, optional)
RESEND_API_KEY=

# Upstash Redis (optional, enables distributed rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact form recipient (optional, requires RESEND_API_KEY)
CONTACT_EMAIL=your-email@example.com
# Resend sender address (optional, defaults to onboarding@resend.dev)
# Set to "계약서 지킴이 <noreply@contract-guardian.kr>" after domain verification
RESEND_FROM_EMAIL=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
